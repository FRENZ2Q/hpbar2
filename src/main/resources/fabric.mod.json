{
  "schemaVersion": 1,
  "id": "hpbar",
  "version": "${version}",
  "name": "HP Bar",
  "description": "Полоска здоровья над игроками, животными и мобами. Работает даже на невидимых. Настраивается по типам (клавиша H).",
  "authors": ["you"],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": ["com.example.hpbar.HpBarClient"]
  },
  "mixins": ["hpbar.mixins.json"],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": ">=1.21 <=1.21.1",
    "java": ">=21",
    "fabric-api": "*"
  }
}
